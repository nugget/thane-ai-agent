# Every path pattern below is anchored to the repo root. Checkouts on
# macOS are case-insensitive (core.ignorecase=true), so an unanchored
# pattern like `knowledge/` or `MEMORY.md` silently ignores source files
# such as internal/state/knowledge/ or docs/understanding/memory.md.

# Build output (`just build` writes to dist/; the rest are binaries from
# building a cmd/ in the repo root). There is deliberately no `/thane`
# entry: case-insensitively it matches the Thane/ dev directory.
/dist/
/openclaw-import
/prewarm-replay
/uiharness
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# Go workspace
/go.work
/go.work.sum

# AI agent tooling
/.claude/

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local config and secrets — unanchored on purpose, so a stray copy is
# never committed from anywhere in the tree.
config.yaml
*.local.yaml
.env

# Databases and logs, wherever they land.
*.db
*.sqlite
*.log

# Development working directory (mirrors ~/Thane/ in production).
/Thane/*
!/Thane/README.md

# Runtime state written by a local `thane serve` or `thane init` in the
# repo root. These are workspace artifacts, not source: the archive
# segments embed absolute paths from whoever ran the binary, and the
# SQLite sidecars change on every run.
/archive/
/core/
/data/
/db/
/generated/
/knowledge/
/logs/
/projects/
/scratchpad/
/talents_backup/

# Site-specific talents (personal to each instance).
/talents/my-*
